# Ascend GTM — Client Environment Variables
# Copy this file to config/.env and fill in the values for this tenant.
# Never commit config/.env — it is git-ignored.

# ── Tenant ──────────────────────────────────────────────────────────────
# Slug that scopes gateway calls and memZERO memory (e.g. "kahuna").
ASCEND_TENANT_SLUG=

# ── Ascend GTM Platform Gateway ─────────────────────────────────────────
# Base URL of the gateway that proxies client API calls.
ASCEND_GATEWAY_URL=

# API key for authenticating with the gateway (issued per operator).
ASCEND_GATEWAY_API_KEY=

# ── memZERO ─────────────────────────────────────────────────────────────
# Endpoint and key for the self-hosted memZERO memory server.
MEMZERO_API_URL=
MEMZERO_API_KEY=

# ── Connectors (optional, managed server-side by the gateway) ───────────
# Most client SaaS credentials (HubSpot, Salesforce, Google Ads, GA4, etc.)
# are stored in the gateway and accessed via api_proxy / nango_proxy.
# Only add variables here for services that run outside the gateway.

# Example: a direct CRM integration not yet routed through the gateway.
# CRM_API_KEY=
# CRM_INSTANCE_URL=

# ── Workflow runtime (optional) ─────────────────────────────────────────
# If this client uses an n8n instance or other workflow engine alongside
# the gateway, add its URL here.
# WORKFLOW_ENGINE_URL=
